    public const SOCIAL_MEDIA_SETTINGS = [];

    /**
     * Get all available settings grouped by type
     */
    public static function getAllSettings(): array
    {
        return array_merge(self::GENERAL_SETTINGS, self::SOCIAL_MEDIA_SETTINGS);
    }

    /**
     * Get all business social media settings
     */
    public static function getBusinessSocialMediaSettings(): array
    {
        return self::BUSINESS_SOCIAL_MEDIA_SETTINGS;
    }

    /**
     * Get settings by group
     */
    public static function getSettingsByGroup(string $group): array
    {
        $allSettings = self::getAllSettings();
        $groupedSettings = [];
        
        foreach ($allSettings as $key => $config) {
            if (isset($config['group']) && $config['group'] === $group) {
                $groupedSettings[$key] = $config;
            }
        }
        
        return $groupedSettings;
    }

    /**
     * Get all groups
     */
    public static function getGroups(): array
    {
        $allSettings = self::getAllSettings();
        $groups = [];
        
        foreach ($allSettings as $config) {
            if (isset($config['group']) && !in_array($config['group'], $groups)) {
                $groups[] = $config['group'];
            }
        }
        
        return $groups;
    }

    /**
     * Get a setting value for the authenticated user
     *
     * @param string $key
     * @param mixed $default
     * @return mixed
     */
    public static function get($key, $default = null)
    {
        if (!Auth::check()) {
            return $default;
        }

        $setting = Setting::where('user_id', Auth::id())
            ->where('setting_key', $key)
            ->first();

        return $setting ? $setting->setting_value : $default;
    }

    /**
     * Get a business setting value
     *
     * @param int $businessId
     * @param string $key
     * @param mixed $default
     * @return mixed
     */
    public static function getBusinessSetting($businessId, $key, $default = null)
    {
        $setting = BusinessSetting::where('business_id', $businessId)
            ->where('setting_key', $key)
            ->first();

        return $setting ? $setting->setting_value : $default;
    }

    /**
     * Set a setting value for the authenticated user
     *
     * @param string $key
     * @param mixed $value
     * @return bool
     */
    public static function set($key, $value, $type = 'general')
    {
        if (!Auth::check()) {
            return false;
        }

        $setting = Setting::updateOrCreate(
            [
                'user_id' => Auth::id(),
                'setting_key' => $key,
            ],
            [
                'setting_value' => $value,
                'setting_type' => $type,
            ]
        );

        return $setting !== null;
    }

    /**
     * Set a business setting value
     *
     * @param int $businessId
     * @param string $key
     * @param mixed $value
     * @return bool
     */
    public static function setBusinessSetting($businessId, $key, $value, $type = 'general')
    {
        $setting = BusinessSetting::updateOrCreate(
            [
                'business_id' => $businessId,
                'setting_key' => $key,
            ],
            [
                'setting_value' => $value,
                'setting_type' => $type,
            ]
        );

        return $setting !== null;
    }

    /**
     * Get all social media settings for the authenticated user
     *
     * @return array
     */
    public static function getSocialMediaSettings()
    {
        if (!Auth::check()) {
            return [];
        }

        $settings = Setting::where('user_id', Auth::id())
            ->whereIn('setting_key', array_keys(self::SOCIAL_MEDIA_SETTINGS))
            ->get()
            ->pluck('setting_value', 'setting_key')
            ->toArray();

        return $settings;
    }

    /**
     * Get all business social media settings
     *
     * @param int $businessId
     * @return array
     */
    public static function getBusinessSocialMediaSettingsForBusiness($businessId)
    {
        $settings = BusinessSetting::where('business_id', $businessId)
            ->whereIn('setting_key', array_keys(self::BUSINESS_SOCIAL_MEDIA_SETTINGS))
            ->get()
            ->pluck('setting_value', 'setting_key')
            ->toArray();

        return $settings;
    }

    /**
     * Check if all required social media settings are configured
     *
     * @param array $requiredKeys
     * @return bool
     */
    public static function hasRequiredSettings($requiredKeys = [])
    {
        if (empty($requiredKeys)) {
            $requiredKeys = ['facebook_client_id', 'facebook_client_secret'];
        }

        $settings = self::getSocialMediaSettings();

        foreach ($requiredKeys as $key) {
            if (empty($settings[$key])) {
                return false;
            }
        }

        return true;
    }

    /**
     * Check if all required business social media settings are configured
     *
     * @param int $businessId
     * @param array $requiredKeys
     * @return bool
     */
    public static function hasBusinessRequiredSettings($businessId, $requiredKeys = [])
    {
        if (empty($requiredKeys)) {
            $requiredKeys = ['facebook_client_id', 'facebook_client_secret'];
        }

        $settings = self::getBusinessSocialMediaSettingsForBusiness($businessId);

        foreach ($requiredKeys as $key) {
            if (empty($settings[$key])) {
                return false;
            }
        }

        return true;
    }

    /**
     * Get a specific social media setting
     *
     * @param string $platform
     * @param string $key
     * @param mixed $default
     * @return mixed
     */
    public static function getSocialMediaSetting($platform, $key, $default = null)
    {
        $settingKey = $platform . '_' . $key;
        return self::get($settingKey, $default);
    }

    /**
     * Get a specific business social media setting
     *
     * @param int $businessId
     * @param string $platform
     * @param string $key
     * @param mixed $default
     * @return mixed
     */
    public static function getBusinessSocialMediaSetting($businessId, $platform, $key, $default = null)
    {
        $settingKey = $platform . '_' . $key;
        return self::getBusinessSetting($businessId, $settingKey, $default);
    }
}